<header class="border-bottom py-3 bg-light">
  <div class="container-fluid d-flex justify-content-between align-items-center">
    
    <!-- Logo -->
    <a href="/" class="d-flex align-items-center">
      <%= image_tag "logo.jpg", size: '100x100', class: "me-3" %>
    </a>

    <!-- Navbar e altri elementi -->
    <div class="d-flex align-items-center">
      <!-- Bottone "Chi siamo" -->
      <a href="/chiSiamo" class="btn btn-primary text-white ms-3">Chi siamo</a>

      <!-- Barra di ricerca -->
      <div class="input-group ms-3" style="max-width: 300px;">
        <input id="src" type="search" class="form-control" placeholder="Cerca persone" aria-label="Search">
        <div class="input-group-append">
          <button class="btn btn-outline-secondary" type="button">
            <i class="fa fa-search"></i>
          </button>
        </div>
      </div>

      <!-- Pulsanti di accesso/registrazione -->
      <% if user_signed_in? %>
        <!-- Dropdown se l'utente è loggato -->
        <div class="dropdown ms-3">
          <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            Ciao, <%= current_user.nome %>
          </button>
          <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
            <a class="dropdown-item" href="/settings">Impostazioni</a>
            <a class="dropdown-item" href="#">Il mio profilo</a>
            <div class="dropdown-divider"></div>
            <%= link_to 'Sign Out', signout_path, method: :delete, class: 'dropdown-item' %>
          </div>
        </div>
      <% else %>
        <!-- Pulsanti di accesso e registrazione se non loggato -->
        <a href="/signin" class="btn btn-primary ms-3">Accedi</a>
        <a href="/signup" class="btn btn-outline-primary ms-3">Registrati</a>
      <% end %>
    </div>
    
  </div>
</header>
